# =============================================================================
# Nepal Origin API — PRODUCTION
# Domains: https://nepalorigin.com.np  |  API: https://api.nepalorigin.com.np
# Copy to server as .env and replace every CHANGE_ME value before starting.
# Never commit real secrets.
# =============================================================================

# ---------- Environment ----------
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=WARNING

# ---------- App ----------
PROJECT_NAME="Nepal Origin API"
API_V1_STR=/api/v1
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=81eeb8282d2520cb2f4a5264190f1460ae869e919a50e51bbcc5a59c5d0951b4
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
DEFAULT_ADMIN_EMAIL=admin@nepalorigin.com.np

# ---------- Public URLs ----------
FRONTEND_URL=https://nepalorigin.com.np
API_URL=https://api.nepalorigin.com.np

# ---------- CORS (exact origins only — never *) ----------
CORS_ORIGINS=https://nepalorigin.com.np,https://www.nepalorigin.com.np

# ---------- Host / HTTPS ----------
ALLOWED_HOSTS=api.nepalorigin.com.np,nepalorigin.com.np,www.nepalorigin.com.np
FORCE_HTTPS=true
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000
CSRF_PROTECT=true
SANITIZE_HTML=true
CONTENT_SECURITY_POLICY=default-src 'none'; frame-ancestors 'none'; base-uri 'none'

# ---------- Cookies (HTTPS required) ----------
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_HTTPONLY=true
COOKIE_PATH=/

# ---------- Auth rate limits ----------
RATE_LIMIT_LOGIN_ATTEMPTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300

# ---------- MySQL ----------
MYSQL_USER=nepalorigin_app
MYSQL_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
MYSQL_SERVER=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=nepalorigin_ecom
# Set true if MySQL is remote or requires TLS
MYSQL_SSL=false
# MYSQL_SSL_CA=/etc/ssl/certs/mysql-ca.pem

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0

# ---------- Email ----------
EMAIL_HOST=mail.nepalorigin.com.np
EMAIL_PORT=465
EMAIL_HOST_USER=noreply@nepalorigin.com.np
EMAIL_HOST_PASSWORD=CHANGE_ME_EMAIL_PASSWORD
FROM_EMAIL=noreply@nepalorigin.com.np

# ---------- Stripe (live) ----------
STRIPE_API_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# ---------- Uploads ----------
UPLOAD_DIR=uploads
