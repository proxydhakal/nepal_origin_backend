# =============================================================================
# Nepal Origin API — example env (placeholders only)
# Copy to .env for local, or use .env.prod for production on nepalorigin.com.np
# =============================================================================

# ---------- Environment ----------
# development = PostgreSQL | production = MySQL
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ---------- App ----------
PROJECT_NAME="Nepal Origin API"
API_V1_STR=/api/v1
SECRET_KEY=CHANGE_ME_GENERATE_WITH_secrets.token_urlsafe
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DEFAULT_ADMIN_EMAIL=admin@example.com

# ---------- URLs ----------
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:8005
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8090

# ---------- Security ----------
ALLOWED_HOSTS=
FORCE_HTTPS=false
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000
CSRF_PROTECT=true
SANITIZE_HTML=true
RATE_LIMIT_LOGIN_ATTEMPTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300

# ---------- Cookies ----------
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_HTTPONLY=true
COOKIE_PATH=/

# ---------- PostgreSQL (development) ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nepalorigin

# ---------- MySQL (production) ----------
MYSQL_USER=nepalorigin_app
MYSQL_PASSWORD=CHANGE_ME
MYSQL_SERVER=localhost
MYSQL_PORT=3306
MYSQL_DB=nepalorigin_ecom
MYSQL_SSL=false
# MYSQL_SSL_CA=/path/to/ca.pem

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- Email ----------
EMAIL_HOST=localhost
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
FROM_EMAIL=noreply@example.com

# ---------- Stripe ----------
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

UPLOAD_DIR=uploads
